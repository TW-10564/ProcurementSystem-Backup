app/data/backups/
# runtime maintenance-mode switch (onefcst.maintenance)
app/data/maintenance.json

# NOTE: Help-page demo videos (app/frontend/public/help/*.mp4, *.webm) are
# deliberately NOT ignored — the training video ships inside the system so
# the team can only watch it by playing it in the portal, rather than it
# circulating as a loose file. See app/frontend/public/help/README.md

# Access DB copies of the SAP stock extract — business data (社外秘), and the
# 2026-07-30 audit found `SAP在庫抽出.db.prev-backup` had been committed
# because only the exact name was ignored. Cover every suffix.
SAP在庫抽出.db*
*.accdb

# stray empty DB at the repo root; the real one is app/data/onefcst.db
/data/onefcst.db

# git worktrees Claude Code creates, plus the archived diffs of removed ones
.claude/worktrees/
.claude/worktree-archive/

# TLS material — NEVER commit. A private key in git history cannot be un-leaked;
# it has to be reissued. Dropped into the repo root 2026-07-30, caught while
# still untracked.
*.pem
*.key
*.crt
*.pfx
*.p12
*.csr
INSTALL_INSTRUCTIONS*.txt

# local SSO trial env (real tenant/client values)
deploy/.env.sso.local

# Real staff roster (names + work addresses). The loader consumes it; the
# repo keeps only deploy/roster.example.csv. Personal data in git history is
# the same class of problem as the SAP .accdb in audit finding F3 — permanent.
deploy/roster.csv
