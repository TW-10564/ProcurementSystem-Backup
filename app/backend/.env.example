# onefcst backend environment — copy to .env and fill in.
# .env is gitignored; NEVER commit a real key.

# ── LLM for compat-rule drafting (any OpenAI-compatible endpoint) ──────────
# Option A: OpenAI API
ONEFCST_LLM_URL=https://api.openai.com
ONEFCST_LLM_API_KEY=sk-REPLACE_ME
ONEFCST_LLM_MODEL=gpt-4o-mini

# Option B: in-house model server (no key needed; data stays internal)
# ONEFCST_LLM_URL=http://172.16.5.105:8000
# ONEFCST_LLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# ONEFCST_LLM_TIMEOUT=120

# ── other optional overrides ───────────────────────────────────────────────
# ONEFCST_API_KEY=            # shared key for the portal API (X-API-Key)
# ONE_SOURCE_DIR=             # path to ONE/ONE Excel files
# PLANNING_DIR=               # path to data/planning
# SAP_DIR=                    # path to data/sap
# ONEFCST_MOQ_EXCESSIVE_MONTHS=6   # "MOQ-driven" order-suggestion flag threshold (months of demand)
