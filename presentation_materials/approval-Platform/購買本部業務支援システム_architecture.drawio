<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="arch-v1" name="System Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="購買本部業務支援システム — System Architecture (on-premises, containerized)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="820" height="30" as="geometry" />
        </mxCell>

        <mxCell id="users" value="Users: 購買本部 procurement staff (~7–10)&#10;Internal network only — browser access&#10;No external exposure, no external DNS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="server" value="On-premises server (社内) — Docker host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;fontSize=13;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="190" width="540" height="400" as="geometry" />
        </mxCell>

        <mxCell id="frontend" value="Frontend container&#10;React dashboard (static build, nginx)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="backend" value="Backend container&#10;FastAPI (onefcst) :8600&#10;X-API-Key auth / CORS restricted&#10;Forecast engine + advisory (no ML)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="210" height="100" as="geometry" />
        </mxCell>

        <mxCell id="postgres" value="PostgreSQL container&#10;(migrated from SQLite)&#10;Regenerable from sources —&#10;not a system of record" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="430" width="210" height="120" as="geometry" />
        </mxCell>

        <mxCell id="refresh" value="Weekly data refresh job&#10;(DB rebuild from NAS sources,&#10;forecast regeneration)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="nas" value="NAS (existing) — READ ONLY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="240" height="360" as="geometry" />
        </mxCell>

        <mxCell id="one" value="ONE planning Excel&#10;(ONE計画 master +&#10;17 parts sub-files, 534 SKUs)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="sap" value="SAP stock extract&#10;(weekly ZM13 export)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sales" value="販売計画 sales-plan files&#10;(①②③④ sources, NotePC plan)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="nasnote" value="No write-back to SAP / ONE&#10;(ingestion is read-only by design)" style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="485" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="openai" value="OpenAI API (external SaaS)&#10;Compat-rule drafting only&#10;Sent data: bare part names ONLY&#10;All drafts require human confirmation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="240" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="github" value="Company GitHub + GitHub Actions (CI/CD — planned)&#10;Build / test / static analysis / container vulnerability scan → deploy images to server&#10;PR review required, no direct push to main" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="650" width="540" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="users" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1l" value="HTTP(S), internal LAN" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="frontend" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2l" value="REST (X-API-Key)" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="backend" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="refresh" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="nas" target="refresh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5l" value="read-only mount" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="backend" target="openai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6l" value="outbound HTTPS (part names only)" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e6">
