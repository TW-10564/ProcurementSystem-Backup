# Copy to the repo root as `.env` (docker compose reads it automatically):
#     cp deploy/compose.env.example .env
# then edit. This file is gitignored at the root — never commit the real one.
#
# ON THE DGX, put it at /srv/onefcst/.env instead and pass it explicitly:
#     docker compose --env-file /srv/onefcst/.env ...
# The CD workflow (.github/workflows/deploy.yml) does exactly that, because it
# drives compose from the runner's disposable checkout — a .env inside the
# repo would be deleted by the next `actions/checkout`.

# ---- database ------------------------------------------------------------
POSTGRES_USER=onefcst
POSTGRES_DB=onefcst
# generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- app -----------------------------------------------------------------
# REQUIRED. Auth is fully OPEN when empty (api/auth.py) — the app would be
# readable by anything that can reach port 8600.
# generate: openssl rand -base64 32
ONEFCST_API_KEY=

# The browser bundle calls /api, which nginx proxies to the app. Leave as-is
# unless you change deploy/nginx-onefcst.conf.
VITE_API_BASE=/api

# Origins allowed to call the API. Empty falls back to localhost-only
# (config.py). DNS A record registered 2026-07-29: one-forecast.twave.co.jp -> 172.16.5.106
ONEFCST_CORS_ORIGINS=https://one-forecast.twave.co.jp

ONEFCST_RATE_LIMIT_PER_MINUTE=120
TZ=Asia/Tokyo

# ---- persistent host directories ----------------------------------------
# Where the app's writable data actually lives on the host: pg_dump backups,
# generated Excel exports, and maintenance.json.
#
# MUST be an absolute path OUTSIDE the git checkout on the DGX. CD checks the
# code out into the runner's workspace and `actions/checkout` runs
# `git clean -ffdx` on an existing clone — with the default relative
# `./app/data` that deletes every backup on the first deploy. The workflow
# refuses to run if these are not absolute.
# Local dev leaves both unset and keeps the in-repo defaults.
ONEFCST_DATA_HOST_DIR=/srv/onefcst/data
SAP_CACHE_HOST_DIR=/srv/onefcst/sap

# ---- NAS (host paths, mounted read-only into the container) --------------
# These are the HOST mount points created by the systemd .mount unit; the
# container always sees /mnt/nas/one and /mnt/nas/planning regardless.
NAS_ONE_DIR=/mnt/nas/one
NAS_PLANNING_DIR=/mnt/nas/planning

# ---- rebuild behaviour ---------------------------------------------------
# 1 = weekly automatic rebuild (default). Set 0 to require the manual button.
ONEFCST_SCHEDULER_ENABLED=1
# pg_dump generations kept in app/data/backups
ONEFCST_DB_BACKUP_KEEP=7
# How long a rebuild waits for the DROP lock before aborting. Aborting is
# SAFE — nothing is dropped — so prefer a short value over a long stall.
ONEFCST_DROP_LOCK_TIMEOUT=15s

# ---- optional -----------------------------------------------------------
# OpenAI key for AI-drafted compatibility rules; leave empty to disable.
ONEFCST_LLM_API_KEY=

# ---- Entra ID SSO (Phase 5 — fill once the platform team registers it) ---
# Until these are set the SSO block in nginx stays disabled and the shared
# API key remains the only authentication.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=https://one-forecast.twave.co.jp/oauth2/callback
# Cookie signing secret for oauth2-proxy (SSO overlay). Must be exactly
# 16, 24 or 32 bytes: openssl rand -base64 32 | head -c 32
# ENTRA_COOKIE_SECRET=
