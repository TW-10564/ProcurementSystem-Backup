# Copy to the repo root as `.env` (docker compose reads it automatically):
#     cp deploy/compose.env.example .env
# then edit. This file is gitignored at the root — never commit the real one.
#
# ON THE DGX, put it at /srv/onefcst/.env instead and pass it explicitly:
#     docker compose --env-file /srv/onefcst/.env ...
# The CD workflow (.github/workflows/deploy.yml) does exactly that, because it
# drives compose from the runner's disposable checkout — a .env inside the
# repo would be deleted by the next `actions/checkout`.

# ---- database ------------------------------------------------------------
POSTGRES_USER=onefcst
POSTGRES_DB=onefcst
# generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- app -----------------------------------------------------------------
# REQUIRED. Auth is fully OPEN when empty (api/auth.py) — the app would be
# readable by anything that can reach port 8600.
# generate: openssl rand -base64 32
ONEFCST_API_KEY=

# The browser bundle calls /api, which nginx proxies to the app. Leave as-is
# unless you change deploy/nginx-onefcst.conf.
VITE_API_BASE=/api

# Origins allowed to call the API. Empty falls back to localhost-only
# (config.py). DNS A record registered 2026-07-29: one-forecast.twave.co.jp -> 172.16.5.106
ONEFCST_CORS_ORIGINS=https://one-forecast.twave.co.jp

ONEFCST_RATE_LIMIT_PER_MINUTE=120
TZ=Asia/Tokyo

# ---- persistent host directories ----------------------------------------
# Where the app's writable data actually lives on the host: pg_dump backups,
# generated Excel exports, and maintenance.json.
#
# MUST be an absolute path OUTSIDE the git checkout on the DGX. CD checks the
# code out into the runner's workspace and `actions/checkout` runs
# `git clean -ffdx` on an existing clone — with the default relative
# `./app/data` that deletes every backup on the first deploy. The workflow
# refuses to run if these are not absolute.
# Local dev leaves both unset and keeps the in-repo defaults.
ONEFCST_DATA_HOST_DIR=/srv/onefcst/data
SAP_CACHE_HOST_DIR=/srv/onefcst/sap

# ---- NAS (host paths, mounted read-only into the container) --------------
# These are the HOST mount points created by the systemd .mount unit; the
# container always sees /mnt/nas/one and /mnt/nas/planning regardless.
NAS_ONE_DIR=/mnt/nas/one

# 企画部's monthly ①②③④ sales plans go in ★販売計画（企画部）, a folder INSIDE
# the ONE share, so by default the container reads them straight from
# /mnt/nas/one/★販売計画（企画部） and NAS_PLANNING_DIR below is unused.
#
# Interim: while those four files still arrive by hand, mount a host directory
# you upload into and point the app back at it —
#   NAS_PLANNING_DIR=/srv/onefcst/planning
#   PLANNING_DIR_IN_CONTAINER=/mnt/nas/planning
# If planning files are missing entirely, the rebuild still succeeds but Gate A
# falls back to master-only (planning1/planning4 contribute nothing).
NAS_PLANNING_DIR=/mnt/nas/planning
# PLANNING_DIR_IN_CONTAINER=/mnt/nas/planning

# ---- rebuild behaviour ---------------------------------------------------
# 1 = weekly automatic rebuild (default). Set 0 to require the manual button.
ONEFCST_SCHEDULER_ENABLED=1
# pg_dump generations kept in app/data/backups
ONEFCST_DB_BACKUP_KEEP=7
# How long a rebuild waits for the DROP lock before aborting. Aborting is
# SAFE — nothing is dropped — so prefer a short value over a long stall.
ONEFCST_DROP_LOCK_TIMEOUT=15s

# ---- optional -----------------------------------------------------------
# OpenAI key for AI-drafted compatibility rules; leave empty to disable.
ONEFCST_LLM_API_KEY=

# ---- Entra ID SSO (MSAL in the SPA — no client secret) ------------------
# The app is a PUBLIC client: MSAL does authorization-code + PKCE in the
# browser and the backend only verifies the token (onefcst/api/entra.py).
# Nothing here is secret — both ids are visible in the browser's address bar
# during any sign-in — and there is deliberately no client secret to store,
# rotate, or have expire unnoticed.
#
# Leave both blank and nothing changes: the shared API key stays the only
# authentication. Set BOTH to require a Microsoft identity on every request.
#
# In Entra, the redirect URI must be registered under the SINGLE-PAGE
# APPLICATION platform (value: https://one-forecast.twave.co.jp — the origin,
# no path). Registering it as "Web" instead makes Entra demand a secret at
# token exchange and sign-in fails with AADSTS7000218.
#
# Restricting WHO may sign in is done in Entra, not here: Enterprise
# application -> Properties -> Assignment required = Yes, then assign the
# staff or a group. Unassigned accounts are refused at Microsoft's own login
# page, before this app sees anything.

# Directory (tenant) ID — a GUID from the app registration Overview blade.
ONEFCST_ENTRA_TENANT_ID=

# Application (client) ID — the other GUID on the same blade.
# NOTE: these two are ALSO compiled into the JS bundle (as VITE_ENTRA_*, wired
# up in docker-compose.yml), so changing either needs `docker compose build`,
# not just a restart.
ONEFCST_ENTRA_CLIENT_ID=

# Expected `aud` claim. Leave blank unless the registration exposes an API
# scope; then set it to api://<client-id> and also set
# VITE_ENTRA_API_SCOPE=api://<client-id>/access_as_user so MSAL requests a
# purpose-built access token instead of sending the ID token.
ONEFCST_ENTRA_AUDIENCE=
# VITE_ENTRA_API_SCOPE=

# 1 = the shared API key is still accepted alongside SSO, for scripted callers
# (monitoring, exports) that cannot sign in interactively.
# 0 = a Microsoft identity is the ONLY way in.
# Either way, build the SPA WITHOUT VITE_API_KEY once SSO is on, so no browser
# is handed a shared key (audit finding F1).
ONEFCST_ENTRA_ALLOW_API_KEY=1

# Optional second gate on top of Entra's app assignment: comma-separated group
# object IDs (the `groups` claim) or app-role values (`roles`). Empty = anyone
# Entra lets sign in, which is correct when assignment is already restricted.
ONEFCST_ENTRA_ALLOWED_GROUPS=

# ---- Entra ID SSO, oauth2-proxy fallback --------------------------------
# Read ONLY by deploy/docker-compose.sso.yml, which is kept for the case where
# the platform team will only issue a Web-platform registration. That design
# DOES need a client secret. Do not run it alongside the MSAL path above.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=          # the VALUE column, not the Secret ID
# ENTRA_REDIRECT_URI=https://one-forecast.twave.co.jp/oauth2/callback
# ENTRA_COOKIE_SECRET=          # exactly 16/24/32 bytes
