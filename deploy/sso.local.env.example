# Local SSO trial only — copy to deploy/.env.sso.local and fill in.
# That filename is gitignored; this example file is not, so put NOTHING real here.

# From the app registration Overview blade (both are GUIDs, neither is secret).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Generated by you, not by Entra. Exactly 16, 24 or 32 bytes:
#   openssl rand -base64 32 | head -c 32
ENTRA_COOKIE_SECRET=

# Leave EMPTY for now. Without it the trial reaches Microsoft's login page and
# then fails at the token exchange with AADSTS7000215 — which still proves
# tenant, client ID, discovery, redirect URI and wiring are all correct.
ENTRA_CLIENT_SECRET=

# Redirect URI. Leave unset for the local trial — it defaults to
#   http://localhost:4180/oauth2/callback
# and that exact string must be registered in Entra.
#
# On the DGX, set it to the production URI instead:
#   ENTRA_REDIRECT_URI=https://one-forecast.twave.co.jp/oauth2/callback
# Entra permits http ONLY for localhost, so there is no http option for a
# hostname or LAN IP — testing from another PC needs the https URL.
# ENTRA_REDIRECT_URI=
