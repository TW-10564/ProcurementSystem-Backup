# Copy to app/frontend/.env.production and fill in real values, then run
# `npm run build` — Vite loads .env.production automatically in build mode.
# Do NOT commit the filled-in copy.
#
# Known limitation (accepted for this internal-only pilot, see
# PILOT_DEPLOY_PLAN.md item #2): VITE_ vars are compiled into the static JS
# bundle in plaintext — anyone who can view-source the deployed page can
# read this key. Acceptable for a small trusted internal user group; not
# sufficient once the user base grows or this becomes reachable outside a
# trusted network.

# Relative path — works because nginx serves the frontend and proxies
# /api/ to the backend from the SAME origin (see nginx-onefcst.conf).
# Do not point this at an absolute http://... URL in production; that
# would defeat the single-origin setup and reintroduce a cross-origin call.
VITE_API_BASE=/api

# Must exactly match ONEFCST_API_KEY in backend.env.production.example.
VITE_API_KEY=
