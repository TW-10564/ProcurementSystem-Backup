# Copy to app/backend/.env.production (referenced by onefcst-backend.service's
# EnvironmentFile) and fill in real values. NEVER commit the filled-in copy —
# it belongs only on the DGX box, outside git (matches how app/backend/.env
# is already gitignored for local dev — see .gitignore).

# Required: shared-secret API auth. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match VITE_API_KEY used when building the frontend (see
# frontend.env.production.example) — the frontend bakes this into its
# static JS bundle at build time, so changing it later requires a rebuild.
ONEFCST_API_KEY=

# The nginx-fronted origin the browser actually loads the SPA from —
# usually unnecessary once frontend+backend share one origin (see
# nginx-onefcst.conf's single-origin design), but set it anyway as
# defense-in-depth in case anything ever calls the API cross-origin.
ONEFCST_CORS_ORIGINS=https://one-forecast.twave.co.jp

# Set only if migrating off SQLite (see this session's DB-portability work
# in db.py/config.py) — otherwise leave unset and it defaults to the local
# SQLite file under app/data/.
# DATABASE_URL=postgresql+psycopg://onefcst:REPLACE_ME@localhost:5432/onefcst

# NAS source paths — override only if the DGX's mounted paths differ from
# the repo-relative defaults in config.py.
# ONE_SOURCE_DIR=/mnt/nas/ONE/ONE
# PLANNING_DIR=/mnt/nas/data/planning
# SAP_DIR=/mnt/nas/data/sap
