<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="phase-plan-v1" name="Phase1→Phase2 Migration Plan (EN)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Procurement Division Business Support System — Phase 1 → Phase 2 Migration Architecture (3-Month Plan)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ================= PHASE 1 ================= -->
        <mxCell id="p1zone" value="Phase 1 — Bridge operation (Months 1–3): current architecture, NAS is READ-ONLY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#39708d;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="700" height="640" as="geometry" />
        </mxCell>

        <mxCell id="p1nas" value="NAS (read-only, TEMPORARY)&#10;Connection removed at end of Month 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#a8524c;strokeWidth=2;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="300" height="255" as="geometry" />
        </mxCell>
        <mxCell id="p1one" value="ONE planning master + 17 sub-files&#10;(534 SKUs)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="75" y="155" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p1sap" value="SAP extracts: ZM13 (stock) / ZP21&#10;saved to NAS weekly by SAP team" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="75" y="222" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p1sales" value="Sales-plan files (①-④, NotePC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="75" y="289" width="270" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p1srv" value="On-premises server (Docker)&#10;- React frontend&#10;- FastAPI backend&#10;- PostgreSQL&#10;NEVER writes to the NAS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3eef4;strokeColor=#39708d;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1users" value="Procurement staff (7-10 users)&#10;Dashboard in use from Month 1&#10;(forecasts / order suggestions / compat)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1parallel" value="From Month 2: parallel run&#10;Portal entries vs ONE files, cell-by-cell&#10;(weekly parity ≥99% × 2 weeks = cutover gate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#faf3d9;strokeColor=#b3a04a;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1note" value="NAS access in these 3 months is read-only, one-direction, and time-boxed.&#10;Its removal is a formal Month-3 completion criterion (a deliverable)." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="640" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p1e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p1nas" target="p1srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e1l" value="weekly ingest (read-only)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="p1e1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p1srv" target="p1users">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= TRANSITION ================= -->
        <mxCell id="trans" value="Month 3 CUTOVER&#10;parity met → NAS removed" style="shape=singleArrow;whiteSpace=wrap;html=1;fillColor=#f6e2e0;strokeColor=#a8524c;fontSize=12;fontStyle=1;arrowWidth=0.55;arrowSize=0.35;" vertex="1" parent="1">
          <mxGeometry x="750" y="300" width="105" height="120" as="geometry" />
        </mxCell>

        <!-- ================= PHASE 2 ================= -->
        <mxCell id="p2zone" value="Phase 2 — Portal is the system of record (Month 4+): NO NAS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4a7a54;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="865" y="60" width="695" height="640" as="geometry" />
        </mxCell>

        <mxCell id="p2plan" value="Planning dept (browser)&#10;Plan entry: CPU / MB / VGA / Case" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="885" y="115" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2buy" value="Purchasing staff 7-10 (browser)&#10;Plan entry: ALL 17 categories at once&#10;(same ownership split as today's sub-files)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="885" y="190" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p2sap" value="SAP data (ZM13 / ZP21)&#10;Weekly manual upload in the portal (~5 min)&#10;matches dept policy — the ONLY external input" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6e2e0;strokeColor=#a8524c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="885" y="280" width="310" height="75" as="geometry" />
        </mxCell>

        <mxCell id="p2srv" value="On-prem server (Docker, same stack)&#10;- Plan entry / approval (versioned, audited)&#10;- Forecast engine + accuracy gates&#10;- PostgreSQL = system of record for all plans" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3eef4;strokeColor=#39708d;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1250" y="140" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2out" value="Dashboard + Excel export&#10;(Excel flips from input to output-only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="370" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2arch" value="ONE Excel: read-only archive&#10;(master compilation abolished → no more drift)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceeec;strokeColor=#6b7570;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="885" y="390" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2note" value="Zero dependency on NAS / ONE files. Only remaining external input = SAP, by manual upload.&#10;Direct SAP integration is a Phase-3 option (out of scope here)." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="885" y="560" width="640" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2plan" target="p2srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2buy" target="p2srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="p2sap" target="p2srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2srv" target="p2out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= TIMELINE ================= -->
        <mxCell id="tlzone" value="3-Month Timeline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5c6870;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tlm1" value="Month 1&#10;- Server deployment (Docker + PostgreSQL migration)&#10;- Production use starts on NAS data (dashboard live)&#10;- Start building plan-entry screens (all 17 + planning 4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3eef4;strokeColor=#39708d;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tlm2" value="Month 2&#10;- One-time import of ONE history (seed data)&#10;- Parallel run: portal entry + Excel continues&#10;- Weekly parity report compares both, cell-by-cell" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#faf3d9;strokeColor=#b3a04a;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="760" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tlm3" value="Month 3&#10;- Parity ≥99% × 2 weeks → cutover&#10;- ONE compilation stops / Excel becomes output-only&#10;- NAS connection removed (Phase-1 exit criterion)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4a7a54;fontSize=11;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="760" width="480" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
